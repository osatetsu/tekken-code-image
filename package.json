{
  "name": "tekken-code-image",
  "version": "1.0.1",
  "description": "Obsidian plugin that converts Tekken fighting game notation DSL into SVG images",
  "main": "dist/main.js",
  "exports": {
    "./integrate": "./src/entries/web/integrate.ts"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "dev:obsidian": "node esbuild.config.mjs --target=obsidian",
    "dev:web": "node esbuild.config.mjs --target=web",
    "build": "node esbuild.config.mjs --production --target=obsidian",
    "build:web": "node esbuild.config.mjs --production --target=web",
    "build:all": "node esbuild.config.mjs --production",
    "test": "vitest run",
    "test:render": "playwright test test/render-svg.pw-spec.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "tekken",
    "svg",
    "fighting-game"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^20.0.0",
    "esbuild": "^0.20.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "happy-dom": "^20.11.1",
    "jsdom": "^30.0.0",
    "obsidian": "latest",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.68.0",
    "vitest": "^1.4.0"
  },
  "dependencies": {
    "chevrotain": "^11.0.0"
  },
  "allowScripts": {
    "esbuild@0.20.2": true,
    "esbuild@0.21.5": true
  }
}
